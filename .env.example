# ─── Core ───────────────────────────────────────────────────
# Public base URL of the app (no trailing slash)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL (use a pooled URL on Vercel, e.g. Neon/Supabase pooler; DIRECT for migrations)
DATABASE_URL="postgresql://postgres:postgres@localhost:54330/tournamenthub"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:54330/tournamenthub"

# ─── Auth.js ────────────────────────────────────────────────
# generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
# Optional Google sign-in (leave blank to hide the Google button)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Initial platform administrator (used ONLY by `npm run admin:create`) ──
ADMIN_EMAIL="sivaprasadpearlaapaati@gmail.com"
# Set a strong password, run the script once, then REMOVE this value.
ADMIN_INITIAL_PASSWORD=""

# ─── Razorpay ──────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Development only: simulate payments without Razorpay keys. Ignored when NODE_ENV=production.
PAYMENTS_DEV_SIMULATOR="false"

# ─── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="TournamentHub <tickets@yourdomain.com>"
# When RESEND_API_KEY is empty, emails are written to the server console (dev only).

# ─── Image storage (Cloudinary) ────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# When Cloudinary is not configured, uploads are saved to /public/uploads (dev only).

# ─── Background jobs ───────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=""

# ─── Landing page media (optional overrides) ───────────────
NEXT_PUBLIC_HERO_VIDEO_URL=""
NEXT_PUBLIC_HERO_POSTER_URL=""

# ─── Demo deployments only ─────────────────────────────────
# "true" = simulated payments (only while Razorpay keys are empty), auto-verified sign-ups
# (only while RESEND_API_KEY is empty) and a "Demo" badge. NEVER set this on the real production site.
DEMO_MODE="false"

# ─── Public contact details shown in the footer / contact page ──
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE=""
