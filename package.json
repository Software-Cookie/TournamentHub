{
  "name": "tournamenthub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:local": "node scripts/dev-db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "admin:create": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "demo:seed": "tsx --env-file-if-exists=.env prisma/seed-demo.ts",
    "demo:clear": "tsx --env-file-if-exists=.env scripts/demo-clear.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.79.0",
    "motion": "^14.14.0",
    "next": "15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.11.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^17.6.0-beta.15",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.6.0-beta.15": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
